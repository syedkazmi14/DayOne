{
  "name": "onboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "dev:voice": "node --env-file-if-exists=.env.local --env-file-if-exists=.env server/voiceProxy.mjs",
    "assets": "node scripts/fetchAssets.mjs && npm run assets:optimize",
    "assets:optimize": "node scripts/optimizeAssets.mjs",
    "build": "tsc -b --noCheck && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "verify": "npm run verify:content && npm run verify:walkthrough",
    "verify:content": "esbuild scripts/validate.ts --bundle --platform=node --format=esm --target=node20 --outfile=scripts/.out/validate.mjs --alias:@=./src --log-level=error && node scripts/.out/validate.mjs",
    "verify:walkthrough": "esbuild scripts/walkthrough.tsx --bundle --platform=node --format=esm --target=node20 --outfile=scripts/.out/walk.mjs --alias:@=./src --external:jsdom --define:process.env.NODE_ENV='\"development\"' --log-level=error && node scripts/.out/walk.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "esbuild": "^0.21.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
